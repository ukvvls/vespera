<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vespera | النظام العصبي للإنتاجية والجسد</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Cairo -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        cairo: ['Cairo', 'sans-serif'],
                    },
                    colors: {
                        glassDark: 'rgba(18, 18, 24, 0.65)',
                        glassBorder: 'rgba(255, 255, 255, 0.08)',
                        accentGlow: '#38bdf8',
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #07090e;
            color: #f1f5f9;
            overflow-x: hidden;
        }

        /* خلفية الإضاءة الحية المتحركة */
        .ambient-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: -1;
            overflow: hidden;
        }
        .blob {
            position: absolute;
            filter: blur(90px);
            opacity: 0.35;
            animation: floatBlob 15s infinite alternate ease-in-out;
        }
        .blob-1 { top: -10%; left: -10%; width: 50vw; height: 50vw; background: #0284c7; }
        .blob-2 { bottom: -10%; right: -10%; width: 55vw; height: 55vw; background: #7c3aed; animation-delay: -5s; }
        .blob-3 { top: 40%; left: 30%; width: 40vw; height: 40vw; background: #059669; animation-delay: -10s; }

        @keyframes floatBlob {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(40px, 50px) scale(1.15); }
        }

        /* تأثير الزجاج السائل الاحترافي iOS Liquid Glass */
        .liquid-glass {
            background: rgba(20, 24, 33, 0.55);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.1);
        }

        .liquid-glass-hover:hover {
            background: rgba(30, 36, 49, 0.7);
            border-color: rgba(56, 189, 248, 0.3);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5), 0 0 20px rgba(56, 189, 248, 0.15);
        }

        /* شبكة المهام الدائرية */
        .task-node-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
            position: relative;
        }

        /* سكرول سائل ونظيف */
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.15); border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(56, 189, 248, 0.4); }

        .rank-badge {
            background: linear-gradient(135deg, rgba(56, 189, 248, 0.2), rgba(124, 58, 237, 0.2));
            border: 1px solid rgba(56, 189, 248, 0.4);
        }
    </style>
</head>
<body class="min-h-screen pb-16">

    <!-- الخلفية الحية المتفاعلة -->
    <div class="ambient-bg">
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
        <div class="blob blob-3"></div>
    </div>

    <!-- الشريط العلوي (Navbar) -->
    <header class="sticky top-0 z-50 px-4 py-3 sm:px-8">
        <div class="max-w-7xl mx-auto liquid-glass rounded-2xl px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-sky-500/30">
                    <i class="fa-solid fa-atom text-white text-lg"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-wider text-white">VESPERA</h1>
                    <p class="text-xs text-sky-400 font-medium">نظام الإنتاجية والتحكم الجسدي الذكي</p>
                </div>
            </div>

            <!-- التنقل السلس -->
            <nav class="flex items-center gap-2 bg-black/30 p-1.5 rounded-xl border border-white/5">
                <button onclick="switchTab('tasks')" id="btn-tasks" class="px-5 py-2 rounded-lg text-sm font-semibold transition-all duration-300 bg-sky-500/20 text-sky-400 border border-sky-500/30 shadow-md">
                    <i class="fa-solid fa-network-wired ml-2"></i>شبكة المهام
                </button>
                <button onclick="switchTab('fitness')" id="btn-fitness" class="px-5 py-2 rounded-lg text-sm font-semibold transition-all duration-300 text-slate-400 hover:text-white">
                    <i class="fa-solid fa-dumbbell ml-2"></i>الجسد والتمارين
                </button>
            </nav>

            <div class="flex items-center gap-3">
                <div class="rank-badge px-4 py-1.5 rounded-full flex items-center gap-2">
                    <span class="text-xs text-slate-300">الرتبة الحالية:</span>
                    <span id="user-rank" class="font-bold text-sky-400 text-base">E</span>
                </div>
            </div>
        </div>
    </header>

    <!-- المحتوى الرئيسي -->
    <main class="max-w-7xl mx-auto px-4 sm:px-8 mt-8">

        <!-- القسم الأول: شبكة المهام (الواضحة وفي المقدمة) -->
        <section id="section-tasks" class="space-y-6 transition-all duration-500">
            <div class="liquid-glass p-6 sm:p-8 rounded-3xl">
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
                    <div>
                        <h2 class="text-2xl font-bold text-white flex items-center gap-3">
                            <i class="fa-solid fa-diagram-project text-sky-400"></i> شبكة المهام اليومية
                        </h2>
                        <p class="text-sm text-slate-400 mt-1">نظم مهامك وتدرج في الرتب من E إلى S بناءً على إنجازاتك الأسبوعية</p>
                    </div>
                    <button onclick="openTaskModal()" class="px-5 py-3 rounded-xl bg-gradient-to-r from-sky-500 to-indigo-600 text-white font-semibold text-sm shadow-lg shadow-sky-500/25 liquid-glass-hover transition-all flex items-center gap-2">
                        <i class="fa-solid fa-plus"></i> إضافة مهمة جديدة
                    </button>
                </div>

                <!-- إحصائيات سريعة للأسبوع -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
                    <div class="liquid-glass p-4 rounded-2xl flex items-center justify-between">
                        <div>
                            <p class="text-xs text-slate-400">مهام منجزة هذا الأسبوع</p>
                            <h3 id="completed-count" class="text-2xl font-bold text-white mt-1">0</h3>
                        </div>
                        <div class="w-12 h-12 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xl">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                    </div>
                    <div class="liquid-glass p-4 rounded-2xl flex items-center justify-between">
                        <div>
                            <p class="text-xs text-slate-400">النسبة المئوية للإنجاز</p>
                            <h3 id="completion-rate" class="text-2xl font-bold text-sky-400 mt-1">0%</h3>
                        </div>
                        <div class="w-12 h-12 rounded-xl bg-sky-500/20 text-sky-400 flex items-center justify-center text-xl">
                            <i class="fa-solid fa-chart-pie"></i>
                        </div>
                    </div>
                    <div class="liquid-glass p-4 rounded-2xl flex items-center justify-between">
                        <div>
                            <p class="text-xs text-slate-400">الرتبة المستهدفة القادمة</p>
                            <h3 id="next-rank-target" class="text-2xl font-bold text-purple-400 mt-1">D (أمامك 5 مهام)</h3>
                        </div>
                        <div class="w-12 h-12 rounded-xl bg-purple-500/20 text-purple-400 flex items-center justify-center text-xl">
                            <i class="fa-solid fa-arrow-trend-up"></i>
                        </div>
                    </div>
                </div>

                <!-- شبكة الدوائر المتصلة (Task Web Grid) -->
                <div id="tasks-grid" class="task-node-grid">
                    <!-- يتم تعبئتها ديناميكياً -->
                </div>
            </div>
        </section>

        <!-- القسم الثاني: الجسد والتمارين وحساب كتلة الجسم -->
        <section id="section-fitness" class="space-y-6 hidden transition-all duration-500">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                
                <!-- بطاقة إدخال القياسات وحساب BMI -->
                <div class="liquid-glass p-6 sm:p-8 rounded-3xl lg:col-span-1 space-y-6">
                    <div>
                        <h3 class="text-xl font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-user-gear text-sky-400"></i> إحصائيات الجسد الحيوية
                        </h3>
                        <p class="text-xs text-slate-400 mt-1">تحديث بياناتك يحسب كتلة الجسم ويدعم أداءك</p>
                    </div>

                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs text-slate-300 mb-1 font-medium">العمر (سنوات)</label>
                            <input type="number" id="input-age" value="22" oninput="updateBodyStats()" class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-2.5 text-white text-sm focus:outline-none focus:border-sky-500">
                        </div>
                        <div>
                            <label class="block text-xs text-slate-300 mb-1 font-medium">الطول (سم)</label>
                            <input type="number" id="input-height" value="175" oninput="updateBodyStats()" class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-2.5 text-white text-sm focus:outline-none focus:border-sky-500">
                        </div>
                        <div>
                            <label class="block text-xs text-slate-300 mb-1 font-medium">الوزن (كجم)</label>
                            <input type="number" id="input-weight" value="70" oninput="updateBodyStats()" class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-2.5 text-white text-sm focus:outline-none focus:border-sky-500">
                        </div>
                    </div>

                    <!-- نتيجة BMI -->
                    <div class="p-4 rounded-2xl bg-black/40 border border-white/5 space-y-2">
                        <div class="flex justify-between items-center text-sm">
                            <span class="text-slate-400">مؤشر كتلة الجسم (BMI):</span>
                            <span id="bmi-value" class="font-bold text-sky-400">22.9</span>
                        </div>
                        <div class="flex justify-between items-center text-sm">
                            <span class="text-slate-400">الحالة البدنية:</span>
                            <span id="bmi-status" class="font-bold text-emerald-400">وزن مثالي وعصري</span>
                        </div>
                    </div>
                </div>

                <!-- ركن التمارين الرياضية اليومية -->
                <div class="liquid-glass p-6 sm:p-8 rounded-3xl lg:col-span-2 space-y-6">
                    <div>
                        <h3 class="text-xl font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-fire text-orange-400"></i> بروتوكول التمارين اليومية لتنشيط القوة
                        </h3>
                        <p class="text-xs text-slate-400 mt-1">سجل إنجازك اليومي للتمارين لرفع طاقة التحمل والرشاقة</p>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- تمرين الضغط -->
                        <div class="liquid-glass p-4 rounded-2xl flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-orange-500/20 text-orange-400 flex items-center justify-center">
                                    <i class="fa-solid fa-hand-fist"></i>
                                </div>
                                <div>
                                    <h4 class="font-bold text-white text-sm">تمارين الضغط (Push-ups)</h4>
                                    <p class="text-xs text-slate-400">الهدف: 50 عدة</p>
                                </div>
                            </div>
                            <button onclick="logWorkout('pushups', 10)" class="px-3 py-1.5 rounded-lg bg-orange-500/20 text-orange-400 text-xs font-semibold hover:bg-orange-500/30 transition-all">
                                + تسجّل
                            </button>
                        </div>

                        <!-- الجري -->
                        <div class="liquid-glass p-4 rounded-2xl flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-sky-500/20 text-sky-400 flex items-center justify-center">
                                    <i class="fa-solid fa-person-running"></i>
                                </div>
                                <div>
                                    <h4 class="font-bold text-white text-sm">الجري / الكارديو</h4>
                                    <p class="text-xs text-slate-400">الهدف: 2 كم</p>
                                </div>
                            </div>
                            <button onclick="logWorkout('running', 1)" class="px-3 py-1.5 rounded-lg bg-sky-500/20 text-sky-400 text-xs font-semibold hover:bg-sky-500/30 transition-all">
                                + تسجّل
                            </button>
                        </div>

                        <!-- العقلة -->
                        <div class="liquid-glass p-4 rounded-2xl flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-purple-500/20 text-purple-400 flex items-center justify-center">
                                    <i class="fa-solid fa-dumbbell"></i>
                                </div>
                                <div>
                                    <h4 class="font-bold text-white text-sm">تمارين العقلة (Pull-ups)</h4>
                                    <p class="text-xs text-slate-400">الهدف: 15 عدة</p>
                                </div>
                            </div>
                            <button onclick="logWorkout('pullups', 5)" class="px-3 py-1.5 rounded-lg bg-purple-500/20 text-purple-400 text-xs font-semibold hover:bg-purple-500/30 transition-all">
                                + تسجّل
                            </button>
                        </div>

                        <!-- البلانك -->
                        <div class="liquid-glass p-4 rounded-2xl flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center">
                                    <i class="fa-solid fa-stopwatch"></i>
                                </div>
                                <div>
                                    <h4 class="font-bold text-white text-sm">بلانك (Core Plank)</h4>
                                    <p class="text-xs text-slate-400">الهدف: 3 دقائق</p>
                                </div>
                            </div>
                            <button onclick="logWorkout('plank', 1)" class="px-3 py-1.5 rounded-lg bg-emerald-500/20 text-emerald-400 text-xs font-semibold hover:bg-emerald-500/30 transition-all">
                                + تسجّل
                            </button>
                        </div>
                    </div>

                    <!-- سجل ملخص التمارين -->
                    <div class="p-4 rounded-2xl bg-black/40 border border-white/5 flex justify-around items-center text-center">
                        <div>
                            <span class="text-xs text-slate-400 block">إجمالي عدات الضغط</span>
                            <span id="stat-pushups" class="text-lg font-bold text-orange-400">0</span>
                        </div>
                        <div class="h-8 w-px bg-white/10"></div>
                        <div>
                            <span class="text-xs text-slate-400 block">مسافة الجري</span>
                            <span id="stat-running" class="text-lg font-bold text-sky-400">0 كم</span>
                        </div>
                        <div class="h-8 w-px bg-white/10"></div>
                        <div>
                            <span class="text-xs text-slate-400 block">دقائق البلانك</span>
                            <span id="stat-plank" class="text-lg font-bold text-emerald-400">0 د</span>
                        </div>
                    </div>
                </div>

            </div>
        </section>

    </main>

    <!-- نافذة منبثقة لإضافة مهمة -->
    <div id="task-modal" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-md hidden items-center justify-center p-4">
        <div class="liquid-glass w-full max-w-md p-6 sm:p-8 rounded-3xl space-y-6 relative">
            <h3 class="text-xl font-bold text-white">إضافة مهمة جديدة لشبكة Vespera</h3>
            <div class="space-y-4">
                <div>
                    <label class="block text-xs text-slate-300 mb-1 font-medium">عنوان المهمة</label>
                    <input type="text" id="new-task-title" placeholder="مثال: إنهاء مشروع العمل، قراءة كتاب..." class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-2.5 text-white text-sm focus:outline-none focus:border-sky-500">
                </div>
                <div>
                    <label class="block text-xs text-slate-300 mb-1 font-medium">مستوى الأهمية (الرتبة)</label>
                    <select id="new-task-rank" class="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-2.5 text-white text-sm focus:outline-none focus:border-sky-500">
                        <option value="E" class="bg-slate-900">رتبة E (روتينية خفيفة)</option>
                        <option value="D" class="bg-slate-900">رتبة D (متوسطة الأهمية)</option>
                        <option value="C" class="bg-slate-900">رتبة C (مهمة أساسية)</option>
                        <option value="B" class="bg-slate-900">رتبة B (عالية الأهمية)</option>
                        <option value="A" class="bg-slate-900">رتبة A (حرجة وصعبة)</option>
                        <option value="S" class="bg-slate-900">رتبة S (أهم إنجاز أسبوعي)</option>
                    </select>
                </div>
            </div>
            <div class="flex justify-end gap-3 pt-2">
                <button onclick="closeTaskModal()" class="px-5 py-2.5 rounded-xl bg-white/5 text-slate-300 text-sm font-semibold hover:bg-white/10 transition-all">إلغاء</button>
                <button onclick="addNewTask()" class="px-5 py-2.5 rounded-xl bg-sky-500 text-white text-sm font-semibold hover:bg-sky-600 transition-all shadow-lg shadow-sky-500/30">حفظ المهمة</button>
            </div>
        </div>
    </div>

    <!-- JavaScript التفاعلي -->
    <script>
        // بيانات الحالة الأولية
        let state = {
            tasks: [
                { id: 1, title: 'مراجعة الميزانية الشهرية والتقارير', rank: 'B', completed: true },
                { id: 2, title: 'جلسة عمل مركزة لمدة ساعتين بدون تشتت', rank: 'A', completed: false },
                { id: 3, title: 'ترتيب مساحة العمل وتنظيم الملفات', rank: 'E', completed: true },
                { id: 4, title: 'إنجاز المشروع التقني الأسبوعي الكبير', rank: 'S', completed: false }
            ],
            workouts: {
                pushups: 30,
                running: 2,
                pullups: 10,
                plank: 2
            }
        };

        // تبديل التبويبات بسلاسة
        function switchTab(tab) {
            const tasksSec = document.getElementById('section-tasks');
            const fitnessSec = document.getElementById('section-fitness');
            const btnTasks = document.getElementById('btn-tasks');
            const btnFitness = document.getElementById('btn-fitness');

            if (tab === 'tasks') {
                tasksSec.classList.remove('hidden');
                fitnessSec.classList.add('hidden');
                btnTasks.className = "px-5 py-2 rounded-lg text-sm font-semibold transition-all duration-300 bg-sky-500/20 text-sky-400 border border-sky-500/30 shadow-md";
                btnFitness.className = "px-5 py-2 rounded-lg text-sm font-semibold transition-all duration-300 text-slate-400 hover:text-white";
            } else {
                tasksSec.classList.add('hidden');
                fitnessSec.classList.remove('hidden');
                btnFitness.className = "px-5 py-2 rounded-lg text-sm font-semibold transition-all duration-300 bg-sky-500/20 text-sky-400 border border-sky-500/30 shadow-md";
                btnTasks.className = "px-5 py-2 rounded-lg text-sm font-semibold transition-all duration-300 text-slate-400 hover:text-white";
            }
        }

        // رندر شبكة المهام
        function renderTasks() {
            const grid = document.getElementById('tasks-grid');
            grid.innerHTML = '';

            let completed = 0;
            state.tasks.forEach(task => {
                if (task.completed) completed++;

                const card = document.createElement('div');
                card.className = `liquid-glass p-5 rounded-2xl flex flex-col justify-between transition-all duration-300 ${task.completed ? 'opacity-75 border-emerald-500/30' : 'liquid-glass-hover'}`;
                
                card.innerHTML = `
                    <div class="flex justify-between items-start gap-3 mb-4">
                        <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-black/40 border border-white/10 text-sky-400">رتبة ${task.rank}</span>
                        <button onclick="toggleTask(${task.id})" class="w-8 h-8 rounded-full flex items-center justify-center transition-all ${task.completed ? 'bg-emerald-500 text-white shadow-lg shadow-emerald-500/30' : 'bg-white/10 text-slate-400 hover:text-white'}">
                            <i class="fa-solid fa-check text-xs"></i>
                        </button>
                    </div>
                    <h3 class="font-semibold text-white text-base mb-4 ${task.completed ? 'line-through text-slate-400' : ''}">${task.title}</h3>
                    <div class="flex justify-between items-center text-xs text-slate-400 pt-3 border-t border-white/5">
                        <span>الحالة: ${task.completed ? 'منجزة' : 'قيد التنفيذ'}</span>
                        <button onclick="deleteTask(${task.id})" class="text-rose-400 hover:text-rose-300 transition-colors"><i class="fa-solid fa-trash"></i></button>
                    </div>
                `;
                grid.appendChild(card);
            });

            // تحديث الإحصائيات والرتبة
            document.getElementById('completed-count').innerText = completed;
            const rate = state.tasks.length > 0 ? Math.round((completed / state.tasks.length) * 100) : 0;
            document.getElementById('completion-rate').innerText = rate + '%';

            // حساب الرتبة الأسبوعية
            let userRank = 'E';
            if (completed >= 8) userRank = 'S';
            else if (completed >= 6) userRank = 'A';
            else if (completed >= 4) userRank = 'B';
            else if (completed >= 2) userRank = 'C';
            else if (completed >= 1) userRank = 'D';

            document.getElementById('user-rank').innerText = userRank;
        }

        function toggleTask(id) {
            state.tasks = state.tasks.map(t => t.id === id ? { ...t, completed: !t.completed } : t);
            renderTasks();
        }

        function deleteTask(id) {
            state.tasks = state.tasks.filter(t => t.id !== id);
            renderTasks();
        }

        function openTaskModal() {
            document.getElementById('task-modal').classList.remove('hidden');
            document.getElementById('task-modal').classList.add('flex');
        }

        function closeTaskModal() {
            document.getElementById('task-modal').classList.add('hidden');
            document.getElementById('task-modal').classList.remove('flex');
        }

        function addNewTask() {
            const title = document.getElementById('new-task-title').value.trim();
            const rank = document.getElementById('new-task-rank').value;
            if (!title) return;

            state.tasks.push({
                id: Date.now(),
                title,
                rank,
                completed: false
            });

            document.getElementById('new-task-title').value = '';
            closeTaskModal();
            renderTasks();
        }

        // حساب مؤشر كتلة الجسم BMI والجسد
        function updateBodyStats() {
            const height = parseFloat(document.getElementById('input-height').value) / 100;
            const weight = parseFloat(document.getElementById('input-weight').value);
            
            if (height > 0 && weight > 0) {
                const bmi = (weight / (height * height)).toFixed(1);
                document.getElementById('bmi-value').innerText = bmi;
                
                let status = "وزن مثالي وعصري";
                let color = "text-emerald-400";
                if (bmi < 18.5) { status = "نحيف (يحتاج زيادة سعرات)"; color = "text-sky-400"; }
                else if (bmi >= 25 && bmi < 30) { status = "وزن زائد قليلًا"; color = "text-amber-400"; }
                else if (bmi >= 30) { status = "يحتاج تركيز على الكارديو"; color = "text-rose-400"; }

                const statusEl = document.getElementById('bmi-status');
                statusEl.innerText = status;
                statusEl.className = `font-bold ${color}`;
            }
        }

        function logWorkout(type, amount) {
            state.workouts[type] += amount;
            document.getElementById('stat-pushups').innerText = state.workouts.pushups;
            document.getElementById('stat-running').innerText = state.workouts.running + ' كم';
            document.getElementById('stat-plank').innerText = state.workouts.plank + ' د';
        }

        // التشغيل الأولي
        renderTasks();
        updateBodyStats();
    </script>
</body>
</html>
